# EXP-010 environment. Copy to .env.local and fill in.
# Builder wallet address (collects fees; needs >=100 USDC in its HL perps account on mainnet).
VITE_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# Set to "true" ONLY after the full testnet checklist is green.
VITE_HL_MAINNET=false
# Optional funnel beacon endpoint (Cloudflare Worker from /worker). Empty = console-only.
VITE_FUNNEL_ENDPOINT=
